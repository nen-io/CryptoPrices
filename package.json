{
  "name": "cryptoprices",
  "version": "2.0.0",
  "description": "A local-first encrypted watch-only crypto portfolio for the desktop.",
  "author": "Ajith",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && node scripts/smoke.mjs",
    "check": "npm run artwork:check && npm run typecheck && npm test && npm run build",
    "package": "npm run check && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "artwork:check": "node scripts/build-history.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.47.0",
    "@scure/base": "2.4.0",
    "viem": "2.56.8",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "@vitejs/plugin-vue": "6.0.9",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  },
  "build": {
    "appId": "io.nen.cryptoprices",
    "productName": "CryptoPrices",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/brand/icon.icns",
      "identity": "-"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/brand/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Finance",
      "maintainer": "nen-io",
      "icon": "build/brand/icon.png"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true,
    "electron@44.4.5": true
  }
}
